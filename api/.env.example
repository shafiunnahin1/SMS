# Education Management SaaS - Laravel environment (docs/architecture/environment-variables.md)
# Copy to .env and run `php artisan key:generate`. Values below are for LOCAL development;
# production values are described in the spec. Never commit .env or real keys (AGENTS.md G17).

APP_NAME="Education Management SaaS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Dhaka
APP_URL=http://admin.lvh.me:8000
FRONTEND_URL=http://admin.lvh.me:5173

APP_LOCALE=bn
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------- Tenancy & domains (docs/modules/custom-domain.md; local: *.lvh.me -> 127.0.0.1) ----------
APP_BASE_DOMAIN=lvh.me
CENTRAL_DOMAINS=lvh.me,admin.lvh.me
SUPER_ADMIN_DOMAIN=admin.lvh.me
DOMAIN_CNAME_TARGET=domains.schoolapp.com
DOMAIN_A_TARGET=
DOMAIN_REQUIRE_APPROVAL=true
DOMAIN_MAX_PER_INSTITUTION=2
# Who may call /api/internal/* (docker compose: add 172.16.0.0/12)
INTERNAL_IPS=127.0.0.1,::1

# ---------- Database (MySQL 8, D1) ----------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=edu_saas
DB_USERNAME=root
DB_PASSWORD=

# D69 (QB.11): the old qbank database, read only by `php artisan qb:import-from-qbank` (placeholders)
QBANK_DB_HOST=127.0.0.1
QBANK_DB_PORT=3306
QBANK_DB_DATABASE=qbank
QBANK_DB_USERNAME=root
QBANK_DB_PASSWORD=

# ---------- Cache, queue, session: Redis (D1) ----------
# No Redis on this machine? Use CACHE_STORE=file, SESSION_DRIVER=file, QUEUE_CONNECTION=sync.
CACHE_STORE=redis
CACHE_PREFIX=
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

BROADCAST_CONNECTION=log

# ---------- Mail (local: written to the log, never sent) ----------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@schoolapp.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------- Files (docs/architecture/file-storage.md, D40): code names only the 'private' and 'public' disks ----------
# local = development / one server | s3 = any S3-compatible store (the ONLY switch for multi-server)
FILES_DRIVER=local
S3_KEY=
S3_SECRET=
S3_REGION=ap-south-1
# Empty for AWS; set for MinIO / another provider
S3_ENDPOINT=
S3_PATH_STYLE=true
# Private bucket: NO public-read, ever
S3_PRIVATE_BUCKET=schoolapp-private
S3_PUBLIC_BUCKET=schoolapp-public
PUBLIC_FILES_URL=
# Only during files:migrate-disk
FILES_FALLBACK_DRIVER=

# ---------- SMS (local: log driver only, G17; docs/modules/notifications.md) ----------
SSL_WIRELESS_TOKEN=
SSL_WIRELESS_SID=
SMS_DEFAULT_SENDER=
SMS_SENDER_MAX_LEN=11
# Default price per prepaid SMS credit
SMS_CREDIT_PRICE_BDT=0.35

# ---------- Payment gateways (local: sandbox only, G17) ----------
# D58: base URL of the bKash tokenized checkout (empty = the production address in config/services.php; the sandbox address comes with the owner's sandbox credentials)
BKASH_BASE_URL=
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_SANDBOX=true

SSLCZ_STORE_ID=
SSLCZ_STORE_PASSWD=
SSLCZ_IS_SANDBOX=true

# Online fee payment (docs/modules/online-fee-payment.md). Platform-collect needs legal advice FIRST.
PLATFORM_COLLECT_ENABLED=false
PLATFORM_COLLECT_FEE_PERCENT=0
# Estimated gateway charge %, used only for settlement arithmetic
GATEWAY_FEE_BKASH=1.5
GATEWAY_FEE_SSLCOMMERZ=2.0
GATEWAY_FEE_NAGAD=1.0
# Add 'banglaqr' only after BanglaQrGateway exists (banglaqr-readiness.md)
ENABLED_GATEWAYS=bkash,sslcommerz

# ---------- Public website (docs/modules/public-website.md) ----------
# Per IP per institution
PUBLIC_ADMISSION_RATE_PER_HOUR=5
PUBLIC_SHELL_PATH=../frontend/dist/index.html

# ---------- Theme ----------
DEFAULT_THEME_PRESET=classic-blue

# ---------- Auth policy: token lifetimes in MINUTES (config/auth_policy.php) ----------
TOKEN_ABS_SUPER_ADMIN=480
TOKEN_IDLE_SUPER_ADMIN=30
TOKEN_ABS_ADMIN=720
TOKEN_IDLE_ADMIN=60
TOKEN_ABS_ACCOUNTANT=720
TOKEN_IDLE_ACCOUNTANT=60
TOKEN_ABS_TEACHER=1440
TOKEN_IDLE_TEACHER=120
TOKEN_ABS_STUDENT=10080
TOKEN_IDLE_STUDENT=1440
TOKEN_ABS_PARENT=43200
TOKEN_IDLE_PARENT=10080
TOKEN_MAX_PER_USER=5
# true = Laravel uncompromised() (calls an external API)
PASSWORD_CHECK_BREACHED=false

# 2FA / OTP
OTP_EXPIRY_MINUTES=5
OTP_LENGTH=6

# ---------- Signup (R16): open only after docs/RELEASE-1.md section 7 is all ticked ----------
SIGNUP_MODE=invite
# Comma-separated codes for the closed beta
SIGNUP_INVITE_CODES=

# ---------- Later-release features (spec Revision 5; off until their release) ----------
WATI_ENDPOINT=https://live-server.wati.io
WATI_TOKEN=
WHATSAPP_ENABLED=false
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_ENABLED=false
QR_CODE_SIZE=200
QR_CODE_ERROR_CORRECTION=H
MULTI_BRANCH_ENABLED=false
MAX_INSTALLMENTS=12
INSTALLMENT_LATE_FINE_PER_DAY=5
EXAM_MAX_QUESTIONS=100
EXAM_AUTO_GRADE=true
CERTIFICATE_STORAGE_PATH=certificates
CERTIFICATE_LOGO_PATH=institution-logo.png
VISITOR_BADGE_PREFIX=VIS
ALUMNI_SELF_REGISTER=true
RATE_LIMIT_BASIC=60
RATE_LIMIT_PRO=120
RATE_LIMIT_ENTERPRISE=300

# ---------- Monitoring & push ----------
FCM_SERVER_KEY=
SENTRY_LARAVEL_DSN=

# PDFs (D50): headless Chromium. Empty binary = auto-detect (google-chrome/chromium on PATH, Windows registry). Needs fonts-noto-core.
PDF_CHROME_BINARY=
# true only where PHP runs as root (containers)
PDF_CHROME_NO_SANDBOX=false

# SMS (D57): the universal API is BulkSMSBD. Keys only on the server (never committed). Empty key = the log driver.
BULKSMSBD_URL=http://bulksmsbd.net/api/smsapi
BULKSMSBD_API_KEY=
BULKSMSBD_SENDER_ID=
BULKSMSBD_SUCCESS_CODES=202
# taka per billable SMS part (D56); the Super Admin setting overrides it
SMS_RATE=0.40
